# Copy to .env (docker compose reads it). Never commit the real file.
POSTGRES_PASSWORD=change-me
OLLAMA_MODEL=qwen2.5:3b

# Only for running services outside Docker:
# RAG service
DATABASE_URL=postgresql://studypath:change-me@localhost:5432/studypath
VECTOR_STORE=pgvector        # or "memory" for a database-free dev mode
LLM_PROVIDER=ollama          # or "hf" (local Hugging Face model, set HF_MODEL / HF_DTYPE)
MIN_SCORE=0.30
# Gateway
MONGO_URL=mongodb://localhost:27017/studypath
RAG_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
# Frontend (baked at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
